<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Android TV -->
    <style name="AppTheme" parent="Theme.Leanback">
        <!-- Ocean Professional overrides -->
        <item name="android:colorPrimary">@color/tv_primary</item>
        <item name="android:colorAccent">@color/tv_secondary</item>
        <item name="android:windowBackground">@color/tv_background</item>
    </style>

    <!-- Leanback header text appearance -->
    <style name="BrowseHeaderStyle" parent="Widget.Leanback.Header">
        <item name="android:textColor">@color/tv_on_primary</item>
    </style>
</resources>
